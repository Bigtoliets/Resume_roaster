# ============================================================
# 简历诊断 Agent 平台 · 环境变量模板
# 用法：复制为 .env 后填写。.env 已在 .gitignore 中，不会进版本库。
# 只需填写标注 [必填] 的地址与凭据，其余保持默认即可。
# ============================================================

# ---------- MySQL（远端已部署）[必填] ----------
MYSQL_HOST=192.168.10.99
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=resume_roaster
MYSQL_CHARSET=utf8mb4

# ---------- Milvus（远端已部署）[必填] ----------
# 注意：稀疏向量与 hybrid search 需要 Milvus ≥ 2.4，推荐 2.5+
MILVUS_HOST=192.168.10.99
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default

# ---------- Langfuse（远端已部署，已实测连通）[必填] ----------
LANGFUSE_BASE_URL=http://192.168.10.99:3000
LANGFUSE_HOST=http://192.168.10.99:3000
LANGFUSE_PUBLIC_HOST=http://192.168.10.99:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
# trace 跳转链接模板，前端用它拼图标链接
LANGFUSE_TRACE_URL_TEMPLATE={host}/project/{project_id}/traces/{trace_id}
LANGFUSE_PROJECT_ID=
# trace 链接模板；把 PROJECT_ID 填上后默认为 {host}/project/{project_id}/traces/{trace_id}
LANGFUSE_TRACE_URL_TEMPLATE={host}/project/{project_id}/traces/{trace_id}

# ---------- 大模型：DeepSeek（OpenAI 兼容协议）[必填] ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_CHAT_MODEL=deepseek-chat
DEFAULT_REASONER_MODEL=deepseek-reasoner

# ---------- Embedding [必填] ----------
# DeepSeek 不提供 embedding 接口，必须另配。三种方式任选：
#   1) 任意 OpenAI 兼容端点（推荐，如 DashScope）：EMBEDDING_PROVIDER=remote
#   2) 本地 BGE-M3：EMBEDDING_PROVIDER=local（需 pip install -e ".[embedding]"）
#   3) 离线联调：EMBEDDING_PROVIDER=fake（确定性哈希向量，无真实语义）
EMBEDDING_PROVIDER=remote
# 下面三个变量也支持 OPENAI_EMBED_API_KEY / OPENAI_EMBED_BASE_URL / OPENAI_EMBED_MODEL 命名
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 必须与接口实际返回维度一致，且与 Milvus collection 维度一致
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_CHARS=8000
EMBEDDING_SEND_DIMENSIONS=true
# 稀疏向量来源：bm25_function（Milvus 2.5 内置 BM25，推荐）| client_side（词袋近似兜底）
MILVUS_SPARSE_MODE=bm25_function

# ---------- 安全 ----------
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ---------- 应用运行时 [默认即可] ----------
APP_ENV=local
# 下面两个端口前后端共用：改这里即可，Vite 会直接读取根目录的 .env
API_PORT=8000
FRONTEND_PORT=5173
UPLOAD_DIR=./uploads
MAX_ROUNDS=5
DIAGNOSIS_TIMEOUT_S=300
LOG_LEVEL=INFO
